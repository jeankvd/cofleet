// Public, non-secret build defaults. Put local signing identifiers only in
// Config/Local.xcconfig, which is intentionally ignored by Git.

SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0
WATCHOS_DEPLOYMENT_TARGET = 10.0

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

COFLEET_BUNDLE_ID_PREFIX = com.example.cofleet
COFLEET_APP_GROUP = group.com.example.cofleet.shared
COFLEET_DEVELOPMENT_TEAM =
COFLEET_CODE_SIGN_IDENTITY = Apple Development
COFLEET_SOURCE_URL = https:/$()/github.com/jeankvd/cofleet
COFLEET_SOURCE_REVISION = development
COFLEET_API_VERSION = v1

DEVELOPMENT_TEAM = $(COFLEET_DEVELOPMENT_TEAM)
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = $(COFLEET_CODE_SIGN_IDENTITY)

ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
SWIFT_STRICT_CONCURRENCY = complete
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
COPY_PHASE_STRIP = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym

#include? "Local.xcconfig"
